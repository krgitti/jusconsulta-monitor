# Porta do servidor (Render/Railway definem automaticamente)
PORT=3000

# Chave para trigger manual do ciclo
ADMIN_KEY=troque-por-uma-chave-secreta

# Resend — https://resend.com (plano gratuito: 3000 e-mails/mês)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=JusConsulta TJSP <noreply@seudominio.com>

# Firebase Admin SDK — JSON do service account (minificado, sem quebras de linha)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Frequência do cron (padrão: a cada 4 horas)
# Exemplos:
#   '0 */4 * * *'  = a cada 4 horas
#   '0 8,12,18 * * *' = às 8h, 12h e 18h
#   '0 */2 * * *'  = a cada 2 horas
CRON_SCHEDULE=0 */4 * * *

# Caminho do banco SQLite (opcional, padrão: ./data/monitor.db)
# DB_PATH=/data/monitor.db
